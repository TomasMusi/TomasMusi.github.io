# Committed and public: VITE_* values end up in the client bundle. Never put secrets here
# (use .env.local, which is git-ignored).

# Production origin, e.g. https://tomasmusil.cz (no trailing slash).
# Until it's set, the build skips canonical/hreflang/og:image tags and sitemap.xml,
# because those must be absolute URLs.
VITE_SITE_URL=
